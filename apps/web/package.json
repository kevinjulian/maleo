{
	"name": "@maleo/web",
	"version": "0.1.0",
	"private": true,
	"description": "Content-first web client",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "MALEO_WEB_PORT=${MALEO_WEB_PORT:-3030} bun --env-file ../../.env --hot src/app/serve.ts",
		"start": "NODE_ENV=production MALEO_WEB_PORT=${MALEO_WEB_PORT:-3030} bun --env-file ../../.env src/app/serve.ts",
		"typecheck": "tsc --noEmit",
		"test": "vp test run --root ../.. --project web",
		"test:bun": "bun test --preload ../../scripts/test-db-guard.ts .bun.test",
		"check:layers": "bun scripts/check-layers.ts",
		"check:census": "bun scripts/census.ts",
		"capture:candidates": "bun scripts/capture-candidates.ts",
		"smoke:prod": "bun scripts/smoke-prod.ts",
		"visual": "playwright test --project=visual --project=mobile",
		"visual:update": "playwright test --project=visual --project=mobile --update-snapshots",
		"perf": "playwright test --project=perf",
		"visual:fixture": "bun visual/fixtures/build.ts",
		"visual:collisions": "bun visual/find-class-collisions.ts",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build -o storybook-static"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@maleo/shared": "workspace:*",
		"@maleo/video": "workspace:*",
		"@remotion/captions": "4.0.462",
		"@remotion/media-utils": "^4.0.0",
		"@remotion/player": "^4.0.466",
		"@remotion/preload": "4.0.462",
		"@soundtouchjs/core": "2.1.1",
		"@videojs/react": "10.0.1",
		"bun-plugin-tailwind": "^0.1.2",
		"html-to-image": "^1.11.13",
		"lucide-react": "^1.48.0",
		"mediabunny": "1.45.0",
		"react": "^19.2.6",
		"react-colorful": "^5.7.0",
		"react-dom": "^19.2.6",
		"remotion": "^4.0.466",
		"zod": "^3.23.0"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^20.11.6",
		"@playwright/test": "^1.62.1",
		"@storybook/react-vite": "^10.6.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/bun": "latest",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"happy-dom": "20.11.6",
		"storybook": "^10.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.6.0",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
