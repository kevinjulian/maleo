{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"types": ["bun-types"],
		"paths": {
			"@maleo/shared": ["./packages/shared/src/index.ts"],
			"@maleo/shared/*": ["./packages/shared/src/*"]
		}
	}
}
