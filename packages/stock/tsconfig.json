{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"types": ["bun-types", "node"],
		"lib": ["ES2022"]
	},
	"include": ["src/**/*", "scripts/**/*", "tests/**/*"]
}
