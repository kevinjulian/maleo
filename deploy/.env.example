# Deployment env — variable NAMES for the core stack. On Coolify, copy the names
# into the resource and set real values there. Self-hosting, copy this file to
# deploy/.env (git-ignored) and fill it in. Never commit real values.
#
# `docker compose --env-file deploy/.env.example -f deploy/docker-compose.yml
# config -q` validates either compose file with them.

# --- durable execution ---
# Self-hosted: the server inside this compose. Hosted: the Inngest Cloud URL and
# its keys, with no other change anywhere.
INNGEST_BASE_URL=http://inngest:8288
INNGEST_EVENT_KEY=replace-with-shared-event-key
# Plain hex. A signkey-prod-… value makes the self-hosted server exit with
# "signing-key must be hex string with even number of chars".
INNGEST_SIGNING_KEY=replace-with-hex-signing-key
INNGEST_PG_PASSWORD=replace-with-strong-password
# Finished-run history older than this is deleted daily. Default 30.
INNGEST_RETENTION_DAYS=30

# --- runtime database (the maleo-postgres service in this stack) ---
MALEO_PG_PASSWORD=replace-with-strong-password
# The pre-Postgres SQLite file, carried over once by db-carry. Default below.
MALEO_DB_PATH=/data/maleo.db

# --- API ---
MALEO_SERVICE_TOKEN=replace-with-worker-token
# 32 bytes, base64 or 64 hex characters: `bun run key:generate`. Back it up.
MALEO_MASTER_KEY=replace-with-master-key
BETTER_AUTH_SECRET=replace-with-session-secret
MALEO_API_PUBLIC_URL=https://api.example.com
MALEO_WEB_PUBLIC_URL=https://app.example.com

# --- video export (API and render worker share this token) ---
MALEO_VIDEO_TOKEN=replace-with-render-token
# Optional. Export renderer authority (remotion|rust) and shadow comparison runs (on|off).
# MALEO_EXPORT_RENDERER=remotion
# MALEO_EXPORT_SHADOW=off

# --- media storage (the rustfs service in this stack) ---
# The internal endpoint is not configurable: the API and the worker reach the
# store at http://rustfs:9000 inside the network. Only the public endpoint, the
# one a browser follows a presigned URL to, is a setting — and it must match the
# domain set for the rustfs service in the Coolify UI.
MALEO_MEDIA_S3_PUBLIC_ENDPOINT=https://media.example.com
MALEO_MEDIA_S3_BUCKET=maleo-media
MALEO_MEDIA_S3_ACCESS_KEY_ID=replace-with-app-key
MALEO_MEDIA_S3_SECRET_ACCESS_KEY=replace-with-app-secret
MALEO_MEDIA_S3_REGION=us-east-1
# The exact web origin allowed to read media in a browser; never *.
MALEO_MEDIA_CORS_ORIGIN=https://app.example.com

# --- self-host only ---
# Address docker-compose.yml publishes web, api and rustfs on. Loopback keeps
# them behind your reverse proxy; Coolify ignores it.
MALEO_BIND_ADDRESS=127.0.0.1

# --- generation ---
# The deployed image provider must need no browser: Cloudflare or Hugging Face.
MALEO_GENERATION_CONCURRENCY_PER_KIND=3
# Worker-owned caption model; persists on worker volume. The image builds the
# whisper.cpp runtime itself.
# MALEO_WHISPER_MODEL=base
# MALEO_CAPTION_TRANSCRIBE=0

# --- dev (local) ---
# No keys needed. Run the in-memory dev binary instead of this stack:
#   bun run dev --only=inngest
# API picks it up automatically (isDev = NODE_ENV !== production).
